# GEMINI_API_KEY: Optional for the AI chat (offline-first by default).
# The app works 100% offline using on-device NLU + ML. Provide a real key
# (overwrite this file as `.env` locally, or set the GEMINI_API_KEY env var
# in your build) to enable cloud Gemini answers as an optional enhancement.
# The placeholder below is safe: the app detects it and falls back offline.
GEMINI_API_KEY=MY_GEMINI_API_KEY
