<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DhanomWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/dhanom_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/dhanom_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/dhanom_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/dhanom_exit</item>
    </style>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/launcher_bg</item>
        <item name="android:statusBarColor">@color/launcher_bg</item>
        <item name="android:navigationBarColor">@color/launcher_bg</item>
        <item name="android:windowAnimationStyle">@style/DhanomWindowAnim</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
